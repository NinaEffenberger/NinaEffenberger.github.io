@unpublished{effenberger2026project1,
  title={Towards best practices for climate data in energy systems modeling },
  author={Vierra, Martha and Effenberger, Nina and Bloomfield, Hannah and Brayshaw, David and DeFelice, Matteo and Gonzalez, Paula and Hawbecker, Patrick and Hodge, Katie R. and Howland, Michael and Kies, Alexander and Kirk-Davidoff, Daniel and Kittel, Martin and Scheiber, Florian and van der Wiel, Karin and Craig, Michael},
  year={2026},
  note={Manuscript submitted},
  abstract={Core idea: As the integration of more renewable energy increases power grid vulnerability to weather, energy modelers require climate datasets to accurately assess system reliability and plan adaptation strategies. In this work, we analyze how emerging AI and data paradigms are reshaping climate data selection, and propose three core best practices to enable robust energy system decisions: meteorological coherence, climate uncertainty characterization, and integrated climate-energy uncertainty contextualization.},
  preview = {turbine.png}
}

@unpublished{effenberger2026project2,
  title={Beyond weather years: Controlling interpretable climate variability to efficiently stress-test energy systems},
  author={Ampelio, Enrico and De Marco, Francesco and Effenberger, Nina and Sansavini, Giovanni},
  year={2026},
  note={In preparation},
  abstract={Core idea: Energy system optimization models are too slow to run on massive weather datasets, making it hard to thoroughly test for specific weather risks. We introduce MAPS, a framework that compresses complex weather data into a simpler latent space so modelers can generate targeted scenarios, for example, a low-wind period in Germany, and directly test how they impact the power grid and system costs.},
  preview = {turbine.png}
}

@unpublished{effenberger2026project3,
  title={Impacts of bias-correction in wind power projections under climate change},
  author={Yang, Minghan and Schillinger, Maybritt and Effenberger, Nina and Samarin, Maxim},
  year={2026},
  note={In preparation},
  abstract={Core idea: Climate datasets contain systematic errors, so modelers and researchers routinely apply bias-correction methods. Yet, how these adjustments distort future wind power projections remains unclear. We evaluate how different bias-correction techniques affect wind power projections under climate change and provide practical guidelines for energy system modeling.},
  preview = {turbine.png}
}


@article{effenberger2026hybrid,
  title={A hybrid machine learning-analog framework for downscaling unprecedented climate extremes},
  abstract={Extreme weather events are critical for climate impact assessments. While physical models can simulate unprecedented extremes, for example, through ensemble boosting, this approach is computationally demanding, often restricting output to coarse spatial resolutions. Probabilistic generative downscaling offers a solution by enabling efficient sampling from the entire climate distribution, including its extreme tails. Here, we first demonstrate that machine learning generated regional climate model heatwaves over Paris are physically realistic. We then leverage an emulated machine learning dataset to perform analog-based downscaling of coarse global climate model ensemble boosting events. Our hybrid framework effectively bridges high-resolution regional detail with rare-event sampling, providing an efficient tool for extreme event downscaling and capturing multi-model uncertainty.},
  author={Effenberger, Nina and Roemer, Florian E and Schillinger, Maybritt and Samarin, Maxim and Fischer, Erich and Knutti, Reto},
  year={2026}, 
  html = {https://arxiv.org/abs/2611.15284},
  selected={true},
  preview = {boosting.png}
}

@article{bloin2026understanding,
  title={Understanding future extreme renewable energy droughts with ensemble boosting},
  abstract={Renewable energy generation and electricity demand are highly weather-dependent, which means that decarbonizing and electrifying the energy system will increase its vulnerability to climate change and extremes. However, since extremes are rare, their effects on the energy system remain challenging to assess in currently available data sets. Here, we overcome this challenge by using ensemble boosting to efficiently sample physically consistent severe energy droughts. Energy droughts are identified by coupling climate simulations to an energy model based on net load, allowing us to directly investigate extremes with the highest system severity. We find that while climate change reduces energy drought severity in systems with high heating demand electrification, these systems are more vulnerable to very severe boosted energy droughts. Indeed, the severity of boosted energy droughts in such a system ranges from 37 to 230 TWh, even though their initial conditions are identical two weeks before event onset. Our results thus highlight the weather-induced unpredictability of net load in fully renewable systems and question the assumption of perfect foresight. In contrast, lower levels of heating electrification lead to shorter, more seasonally widespread extremes that are less affected by climate change, although the most severe energy droughts still occur in fall and winter. Regardless of electrification levels, wind speed deficits, seasonally low solar PV and the gradual depletion of hydropower storage over winter also contribute to the severity of the extreme renewable energy droughts studied. Our results demonstrate the power of ensemble boosting to inform future planning by uncovering system vulnerabilities.},
  html = {https://essopenarchive.org/doi/pdf/10.22541/essoar.15012112/v1},
  author={Bloin-Wibe, Luna and Beyerle, Urs and Effenberger, Nina and Fischer, Erich Markus and Wohland, Jan and Knutti, Reto},
  year={2026}, 
  preview = {drought_boosting.png},
  selected={true},
}
@article{effenberger2026uncertainty,
  title={Uncertainty in wind and solar projections in the Alpine region depends on global and regional climate models},
  author={Effenberger, Nina and Knutti, Reto},
  abstract={Ensembles of regional-global climate model combinations show substantial spread in projected wind and solar resources. Using 31 RCM-GCM pairs, we quantify the sources of this spread in the Alpine region with a spatially and seasonally resolved variance decomposition, separating contributions from RCMs and GCMs. For both wind speed and solar radiation, RCMs dominate the variability in the absolute historical fields. In contrast, projected changes in wind speed are largely controlled by the driving GCMs, except in mountainous regions where RCM-induced variance becomes larger than that induced by GCMs. For solar radiation, contributions are strongly season-dependent, with RCMs dominating in summer and GCMs in winter. Our findings support that GCM and RCM variability together define the uncertainty of wind and solar climate projections. This provides guidance for designing climate model ensembles that better support uncertainty-aware energy system decisions under climate change.},
  journal={Environmental Research Communications},
  year={2026},
  selected={false},
  html = {https://iopscience.iop.org/article/10.1088/2515-7620/ae9136/meta}, 
  preview = {0057_overview_anova.png}
}

@article{effenberger2025bridging,
  title={Bridging CORDEX and CMIP6: Machine learning downscaling for wind and solar energy droughts in Central Europe},
  abstract={Reliable regional climate information is essential for assessing the impacts of climate change and for planning in sectors such as renewable energy; yet, producing high-resolution projections through coordinated initiatives like CORDEX that run multiple physical regional climate models is both computationally demanding and difficult to organize. Machine learning emulators that learn the mapping between global and regional climate fields offer a promising way to address these limitations. Here we introduce the application of such an emulator: trained on CMIP5 and CORDEX simulations, it reproduces regional climate model data with sufficient accuracy. When applied to CMIP6 simulations not seen during training, it also produces realistic results, indicating stable performance. Using CORDEX data, CMIP5 and CMIP6 simulations, as well as regional data generated by two machine learning models, we analyze the co-occurrence of low wind speed and low solar radiation and find indications that the number of such energy drought days is likely to decrease in the future. Our results highlight that downscaling with machine learning emulators provides an efficient complement to efforts such as CORDEX, supplying the higher-resolution information required for impact assessments.},
  author={Effenberger, Nina and Samarin, Maxim and Schillinger, Maybritt and Knutti, Reto},
  journal={Machine Learning: Earth},
  volume={2},
  number={2},
  pages={025020},
  year={2026},
  publisher={IOP Publishing},
  html={https://iopscience.iop.org/article/10.1088/3049-4753/aea998/meta},
  preview = {cordex_cmip6.png}, 
  selected={true},
}

@article{schmidt2026bridging,
  title={How can machine learning emulators best support climate science?},
  abstract={Climate model emulation using machine learning has emerged as a powerful tool for understanding and predicting climate dynamics. However, the integration of climate science principles with machine learning techniques remains a challenge. This paper presents a comprehensive framework for bridging this gap, focusing on the development of interpretable and physically consistent emulators. We discuss the importance of incorporating domain knowledge into model architecture, training processes, and evaluation metrics. Case studies demonstrate the effectiveness of our approach in improving emulator performance and reliability, ultimately enhancing our ability to make accurate climate projections.},
  author={Schmidt*, Luca and Effenberger*, Nina and Benson, Vitus and Bommer, Philine L. and Brunstein, Robert and Legasa, Mikel N. and Samarin, Maxim and Schillinger, Maybritt},
  year={2026},
  selected={true},
  html = {https://arxiv.org/abs/2603.22320}, 
  preview = {position.png}
}


@article{morelli2025climate,
  title={Climate data selection for multi-decadal wind power forecasts},
  author={Morelli*, Sofia and Effenberger*, Nina and Schmidt*, Luca and Ludwig, Nicole},
  abstract= {Reliable wind speed data is crucial for applications such as estimating local (future) wind power.
Global climate models (GCMs) and regional climate models (RCMs) provide forecasts over
multi-decadal periods. However, their outputs vary substantially, and higher-resolution models
come with increased computational demands. In this study, we analyze how the spatial resolution
of different GCMs and RCMs affects the reliability of simulated wind speeds and wind power,
using ERA5 data as a reference. We present a systematic procedure for model evaluation for wind
resource assessment as a downstream task. Our results show that while a high spatial resolution can
improve the representation of wind speed characteristics, notably extremes, the model choice is
more critical for capturing the full wind speed distribution and corresponding power generation.
The IPSL model preserves the wind speed distribution particularly well in Europe, producing the
most accurate wind power forecasts relative to ERA5 data. Therefore, selecting the right GCMs and
RCMs should precede considerations of spatial resolution or GCM boundary conditions. However,
higher resolution can be valuable once a suitable climate model is identified.},
  journal={Environmental Research Letters},
  volume={20},
  number={4},
  pages={044032},
  year={2025},
  publisher={IOP Publishing},
  selected={false},
  html = {https://iopscience.iop.org/article/10.1088/1748-9326/adc01f/pdf}, 
  preview = {resolution.png}
}

@article{effenberger2024turbine,
  title={Turbine location-aware multi-decadal wind power predictions for Germany using CMIP6},
  abstract={Climate change will impact wind and, therefore, wind power generation with largely unknown effects and magnitude. Climate models can provide insight and should be used for long-term power planning. In this work, we use Gaussian processes to predict power output given wind speeds from a global climate model. We validate the aggregated predictions from past climate model data with actual power generation, which supports using CMIP6 climate model data for multi-decadal wind power predictions and highlights the importance of being location-aware. We find that wind power projections for the two in-between climate scenarios, SSP2–4.5 and SSP3–7.0, closely align with actual wind power generation between 2015 and 2023. Our location-aware future predictions up to 2050 reveal only minor changes in yearly wind power generation. Our analysis also reveals larger uncertainty associated with Germany’s coastal areas in the North than Germany’s South, motivating wind power expansion in regions where the future wind is likely more reliable. Overall, our results indicate that wind energy will likely remain a reliable energy source.},
  author={Effenberger, Nina and Ludwig, Nicole},
  volume={4}, 
  DOI={10.1017/eds.2025.10018}, 
  journal={Environmental Data Science},
  year={2025}, 
  html = {https://www.cambridge.org/core/journals/environmental-data-science/article/turbine-locationaware-multidecadal-wind-power-predictions-for-germany-using-cmip6/9B04AD4A748F6EC922914AA5633E4CD3},
  preview = {locations.png},
}

